---
import { IconClock, IconShirt } from '@tabler/icons-react';
import { eventConfig } from '@/data/event';

const { person, date, venue, dressCode } = eventConfig;

const TILE = 'min-h-0 overflow-hidden bg-surface';
const CONTENT = 'flex h-full flex-col justify-between p-5 opacity-0 sm:p-8';
const LABEL = 'text-xs uppercase tracking-[0.14em] text-muted sm:text-sm';
const VALUE = 'text-[length:clamp(1.25rem,2.6vw,2.5rem)] font-medium leading-tight text-ink';
---

<div data-part="name-tile" class:list={[TILE, 'tile-name col-span-2']}>
  <div data-part="tile-content" class="flex h-full items-center gap-3 p-5 opacity-0 sm:gap-5 sm:p-8">
    <div data-part="name-end" aria-hidden="true" class="invisible shrink-0"></div>
    <p data-part="age-end" class="font-display text-[clamp(1.25rem,2.4vw,2rem)] italic text-muted">
      {person.age} anos
    </p>
  </div>
</div>

<div class:list={[TILE, 'tile-mid']}>
  <div data-part="tile-content" class={CONTENT}>
    <p class={LABEL}>Horário</p>
    <div class="flex items-center gap-3">
      <IconClock size={28} className="shrink-0 text-brand" />
      <p class={VALUE}>{date.displayTime}</p>
    </div>
  </div>
</div>

<div class:list={[TILE, 'tile-mid']}>
  <div data-part="tile-content" class={CONTENT}>
    <p class={LABEL}>Local</p>
    <div>
      <svg viewBox="0 0 120 30" class="mb-2 h-8 w-full max-w-48 sm:h-12" fill="none" aria-hidden="true">
        <path d="M10 24 Q 40 2 62 15 T 110 6" class="stroke-line" stroke-width="1.5" stroke-dasharray="5 5"></path>
        <circle cx="10" cy="24" r="4" class="fill-brand"></circle>
        <circle cx="110" cy="6" r="4" class="fill-brand"></circle>
      </svg>
      <p class="text-[clamp(1rem,1.8vw,1.75rem)] font-medium leading-tight text-ink">{venue.name}</p>
    </div>
  </div>
</div>

<div class:list={[TILE, 'tile-mid col-span-2 sm:col-span-1']}>
  <div data-part="tile-content" class="flex h-full items-center justify-between gap-3 p-5 opacity-0 sm:p-8">
    <div>
      <p class={LABEL}>{dressCode.title}</p>
      <p class="mt-1 text-[clamp(1rem,1.6vw,1.5rem)] font-medium leading-tight text-ink">
        {dressCode.description}
      </p>
    </div>
    <IconShirt size={32} className="shrink-0 text-brand" />
  </div>
</div>

<div data-part="countdown-tile" class:list={[TILE, 'tile-cd col-span-2 sm:col-span-1']}>
  <div data-part="tile-content" class={CONTENT}>
    <p class={LABEL}>Faltam</p>
    <div data-part="countdown-end" aria-hidden="true" class="invisible"></div>
  </div>
</div>