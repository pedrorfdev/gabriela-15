---
import { Image } from 'astro:assets';
import { eventConfig } from '@/data/event';
import { heroPhotos } from '@/data/photos';
import { getDateParts } from '@/lib/eventDate';

const { day, month, year } = getDateParts(eventConfig.date.iso);
---

<div data-slides class="absolute inset-0 bg-linear-to-b from-band to-soft">
  {
    heroPhotos.map((photo, index) => (
      <div
        data-slide
        data-active={String(index === 0)}
        class="absolute inset-0 opacity-0 transition-opacity duration-1000 data-[active=true]:opacity-100"
      >
        <Image
          src={photo.image}
          alt={photo.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 640px) 26vw, 100vw"
          loading={index === 0 ? 'eager' : 'lazy'}
          class="size-full object-cover"
        />
      </div>
    ))
  }
  <div class="absolute inset-x-0 bottom-0 h-full bg-linear-to-t from-scrim to-transparent sm:h-3/5"></div>
</div>

<div
  class="absolute inset-0 z-10 flex flex-row items-center justify-center gap-3 text-on-photo sm:flex-col sm:justify-end sm:gap-1 sm:pb-[min(4svh,2rem)]"
>
  <span class="text-xs uppercase tracking-[0.18em] sm:text-sm">{month}</span>
  <span class="font-display text-[clamp(3rem,min(7vw,13svh),7rem)] italic leading-none">{day}</span>
  <span class="text-xs uppercase tracking-[0.18em] sm:text-sm">{year}</span>
</div>