---
// Same visual language as DecorativeMap.astro (dashed route + pins),
// stripped of the background rect so it sits quietly on a dark
// section instead of looking like a floating light card.
---

<svg viewBox="0 0 160 140" class="h-full w-full" fill="none" xmlns="http://www.w3.org/2000/svg">
  <path
    d="M20 120 Q 60 90 45 55 T 130 20"
    stroke="var(--color-gold-soft)"
    stroke-width="1.5"
    stroke-dasharray="6 6"
    fill="none"
    opacity="0.7"
  />
  <circle cx="20" cy="120" r="5" fill="var(--color-gold-soft)" opacity="0.8" />
  <circle cx="130" cy="20" r="5" fill="var(--color-gold-soft)" opacity="0.8" />
  <circle cx="20" cy="120" r="9" fill="none" stroke="var(--color-gold-soft)" stroke-width="1" opacity="0.4" />
  <circle cx="130" cy="20" r="9" fill="none" stroke="var(--color-gold-soft)" stroke-width="1" opacity="0.4" />
</svg>