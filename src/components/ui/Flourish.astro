---
interface Props {
  align?: 'left' | 'center';
}

const { align = 'center' } = Astro.props;
---

<div class:list={['mb-5 mt-3 flex items-center gap-2', align === 'center' && 'justify-center']} aria-hidden="true">
  <span class="h-px w-8 bg-line"></span>
  <span class="size-1.5 rounded-full bg-brand"></span>
  <span class="h-px w-8 bg-line"></span>
</div>