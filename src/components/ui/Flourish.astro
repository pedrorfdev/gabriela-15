---
interface Props {
  align?: 'left' | 'center';
}

const { align = 'center' } = Astro.props;
---

<div class:list={['flourish', align === 'left' && 'justify-start']}>
  <span></span>
  <svg width="14" height="14" viewBox="0 0 14 14">
    <g fill="var(--color-accent-soft)">
      <circle cx="7" cy="3" r="2.4"></circle>
      <circle cx="11" cy="7" r="2.4"></circle>
      <circle cx="7" cy="11" r="2.4"></circle>
      <circle cx="3" cy="7" r="2.4"></circle>
    </g>
    <circle cx="7" cy="7" r="2" fill="var(--color-gold-soft)"></circle>
  </svg>
  <span></span>
</div>
