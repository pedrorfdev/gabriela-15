---
import { IconArrowUp } from '@tabler/icons-react';
---

<button
  id="back-to-top"
  type="button"
  aria-label="Voltar ao topo"
  data-visible="false"
  class="invisible fixed bottom-6 left-6 z-40 flex size-12 items-center justify-center rounded-full border border-border bg-surface text-ink opacity-0 transition-[opacity,visibility] duration-300 hover:text-accent data-[visible=true]:visible data-[visible=true]:opacity-100"
>
  <IconArrowUp size={18} />
</button>

<script>
  function initBackToTop() {
    const button = document.getElementById('back-to-top');
    if (!button) return;

    const update = () => {
      button.dataset.visible = String(window.scrollY > window.innerHeight * 0.6);
    };

    button.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  initBackToTop();
</script>