---
import { IconArrowUp } from '@tabler/icons-react';
---

<button
  id="back-to-top"
  aria-label="Voltar ao topo"
  class="fixed bottom-6 left-6 z-40 flex h-12 w-12 items-center justify-center rounded-full border border-black/10 bg-surface text-ink opacity-0 shadow-none transition-opacity duration-300"
>
  <IconArrowUp size={18} />
</button>

<script>
  function initBackToTop() {
    const button = document.getElementById('back-to-top');
    if (!button) return;

    function updateVisibility() {
      const scrolledPastHero = window.scrollY > window.innerHeight * 0.6;
      button!.style.opacity = scrolledPastHero ? '1' : '0';
      button!.style.pointerEvents = scrolledPastHero ? 'auto' : 'none';
    }

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    window.addEventListener('scroll', updateVisibility, { passive: true });
    updateVisibility();
  }

  initBackToTop();
</script>