---
import { IconArrowRight } from '@tabler/icons-react';
import Flourish from '@/components/ui/Flourish.astro';
import GeoCircle from '@/components/ui/GeoCircle.astro';
import { giftsPage } from '@/data/gifts';
import { giftIcons } from '@/lib/giftIcons';
---

<section
  id="gifts"
  class="fade-in-section relative flex min-h-svh items-center overflow-hidden bg-blush-band px-4 py-16 sm:px-16 sm:py-20"
>
  <GeoCircle size="280px" color="rgba(212, 175, 106, 0.25)" top="-100px" left="-90px" />
  <GeoCircle size="200px" color="rgba(156, 79, 104, 0.15)" bottom="-80px" right="-60px" />

  <div class="relative z-10 mx-auto grid w-full max-w-5xl gap-10 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-14">
    <div>
      <p class="font-display text-4xl italic text-ink sm:text-5xl lg:text-6xl">Presentes</p>
      <Flourish align="left" />
      <p class="text-base text-muted">sua presença já é o maior presente</p>
    </div>

    <a
      href="/presentes"
      class="gift-card group block cursor-pointer border border-border bg-surface p-6 text-left sm:p-8"
    >
      <div class="mb-6 flex flex-wrap gap-3">
        {giftsPage.categories.map((category) => {
          const Icon = giftIcons[category.icon];
          return (
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent/10 text-accent">
              <Icon size={20} />
            </span>
          );
        })}
      </div>

      <div class="flex items-center justify-between gap-4">
        <div>
          <span class="block text-lg font-medium text-ink sm:text-xl">Ver ideias de presentes</span>
          <span class="text-sm text-muted">Algumas ideias para inspirar</span>
        </div>
        <IconArrowRight
          size={22}
          className="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1"
        />
      </div>
    </a>
  </div>
</section>

<style>
  .gift-card {
    border-radius: 16px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .gift-card:hover {
    transform: scale(0.98);
    border-color: var(--color-accent);
  }

  .fade-in-section {
    opacity: 0;
    transition: opacity 1s ease;
  }
  .fade-in-section.is-visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in-section {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  function initGiftsFadeIn() {
    const section = document.getElementById('gifts');
    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15 },
    );

    observer.observe(section);
  }

  initGiftsFadeIn();
</script>