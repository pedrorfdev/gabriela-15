---
import { IconArrowRight } from '@tabler/icons-react';
import Flourish from '@/components/ui/Flourish.astro';
import { giftsPage } from '@/data/gifts';
import { giftIcons, giftTints } from '@/lib/giftIcons';
---

<section id="gifts" class="flex min-h-svh items-center bg-band px-4 py-16 sm:px-12 sm:py-20">
  <div
    data-reveal
    data-from="bottom"
    class="reveal mx-auto grid w-full max-w-5xl gap-10 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-14"
  >
    <div>
      <h2 class="font-display text-4xl italic text-ink sm:text-5xl lg:text-6xl">Presentes</h2>
      <Flourish align="left" />
      <p class="text-base text-muted">sua presença já é o maior presente</p>
    </div>

    <a
      href="/gifts"
      class="group block rounded-card border border-border bg-surface p-6 transition-[transform,border-color] duration-300 hover:scale-[0.98] hover:border-accent sm:p-8"
    >
      <div class="mb-6 flex flex-wrap gap-3">
        {
          giftsPage.categories.map((category, index) => {
            const Icon = giftIcons[category.icon];
            return (
              <span
                class:list={[
                  'flex size-11 items-center justify-center rounded-full',
                  giftTints[index % giftTints.length],
                ]}
              >
                <Icon size={20} />
              </span>
            );
          })
        }
      </div>

      <div class="flex items-center justify-between gap-4">
        <div>
          <span class="block text-lg font-medium text-ink sm:text-xl">Ver ideias de presentes</span>
          <span class="text-sm text-muted">Algumas pistas do que a Gabi gosta</span>
        </div>
        <IconArrowRight
          size={22}
          className="flex-none text-brand transition-transform duration-300 group-hover:translate-x-1"
        />
      </div>
    </a>
  </div>
</section>