---
import Gallery from '@/components/islands/Gallery';
import Flourish from '@/components/ui/Flourish.astro';
import { galleryPhotos } from '@/data/photos';

const subtitle = galleryPhotos.length === 0 ? 'em breve, os registros da festa' : 'os registros da festa';
---

<section id="gallery" class="flex min-h-svh flex-col justify-center bg-surface py-16 sm:py-20">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-12">
    <h2 class="font-display text-4xl italic text-ink sm:text-5xl lg:text-6xl">Galeria</h2>
    <Flourish align="left" />
    <p class="mb-8 text-base text-muted">{subtitle}</p>

    <Gallery client:visible />
  </div>
</section>