---
import DecorativeMap from '@/components/ui/DecorativeMap.astro';
import Flourish from '@/components/ui/Flourish.astro';
import { recommendations } from '@/data/event';
import { getRecommendationIcon } from '@/lib/recommendationIcons';

// Only a real path or URL counts as a photo; anything else shows the icon tile.
const isPhoto = (image?: string) => Boolean(image && /^(\/|https?:)/.test(image));
---

<section id="recommendations" class="overflow-hidden bg-surface px-4 py-16 sm:px-12 sm:py-24">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_220px] lg:gap-16">
    <div>
      <h2 class="font-display text-4xl italic text-ink sm:text-5xl lg:text-6xl">Recomendações</h2>
      <Flourish align="left" />

      <ul class="flex flex-col gap-3">
        {
          recommendations.map((item, index) => {
            const Icon = getRecommendationIcon(item.category);
            return (
              <li data-reveal data-from={index % 2 === 0 ? 'left' : 'right'} class="reveal">
                <article class="flex flex-col gap-4 rounded-card p-4 transition-colors hover:bg-brand/5 sm:flex-row sm:items-center sm:gap-6">
                  {isPhoto(item.image) ? (
                    <img
                      src={item.image}
                      alt={item.name}
                      loading="lazy"
                      class="h-44 w-full flex-none rounded-tile object-cover sm:size-36"
                    />
                  ) : (
                    <div
                      aria-hidden="true"
                      class="flex h-44 w-full flex-none items-center justify-center rounded-tile bg-band text-brand sm:size-36"
                    >
                      <Icon size={56} stroke={1.5} />
                    </div>
                  )}

                  <div>
                    <span class="rounded-full bg-band px-3 py-1 text-[11px] uppercase tracking-wide text-accent">
                      {item.categoryLabel}
                    </span>
                    <h3 class="mt-3 font-display text-2xl italic text-ink">{item.name}</h3>
                    <p class="text-base text-muted">{item.description}</p>
                    {item.mapsUrl && (
                      <a
                        href={item.mapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 inline-block text-xs uppercase tracking-wide text-accent underline-offset-4 hover:underline"
                      >
                        Ver no mapa
                      </a>
                    )}
                  </div>
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="hidden lg:block">
      <DecorativeMap />
    </div>
  </div>
</section>