---
import Flourish from '@/components/ui/Flourish.astro';
import DecorativeMap from '@/components/ui/DecorativeMap.astro';
import { recommendations } from '@/data/event';
---

<section id="recommendations" class="relative overflow-hidden bg-surface px-4 py-16 sm:px-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_280px] lg:gap-16">
    <div>
      <p class="font-display text-4xl italic text-ink sm:text-5xl lg:text-6xl">Recomendações</p>
      <Flourish align="left" />

      <div class="flex flex-col gap-3">
        {recommendations.map((item, index) => (
          <div
            class="rec-card flex flex-col items-start gap-4 rounded-2xl p-4 transition-colors hover:bg-accent/5 sm:flex-row sm:items-center sm:gap-6 sm:p-5"
            data-direction={index % 2 === 0 ? 'left' : 'right'}
          >
            <div
              class="h-36 w-full shrink-0 rounded-xl sm:h-30 sm:w-42.5"
              style={{ background: `linear-gradient(135deg, ${item.imageColor}, #FFFFFF20)` }}
            />
            <div class="text-left">
              <span class="rounded-full bg-accent/10 px-3 py-1.5 text-xs uppercase tracking-wide text-accent">
                {item.categoryLabel}
              </span>
              <p class="mt-3 font-serif text-2xl italic text-ink">{item.name}</p>
              <p class="text-base text-muted">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hidden self-center lg:block">
      <DecorativeMap />
    </div>
  </div>
</section>

<style>
  .rec-card {
    opacity: 0;
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .rec-card[data-direction='left'] { transform: translateX(-70px); }
  .rec-card[data-direction='right'] { transform: translateX(70px); }
  .rec-card.is-visible { opacity: 1; transform: translateX(0); }

  @media (prefers-reduced-motion: reduce) {
    .rec-card { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function initRecommendationsReveal() {
    const cards = document.querySelectorAll('.rec-card');
    if (cards.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    cards.forEach((card) => observer.observe(card));
  }

  initRecommendationsReveal();
</script>