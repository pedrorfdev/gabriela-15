---
import { IconMail } from '@tabler/icons-react';
import MessagesGrid from '@/components/islands/MessagesGrid';
import Flourish from '@/components/ui/Flourish.astro';
import { eventConfig } from '@/data/event';
---

<section
  id="messages"
  class="relative flex min-h-[75vh] flex-col items-center justify-center overflow-hidden bg-blush-band px-6 py-16 sm:px-16"
>
  <IconMail size={420} className="pointer-events-none absolute -right-16 -top-16 text-ink/3" />

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <p class="font-display text-5xl italic text-ink sm:text-6xl">Mensagens</p>
    <Flourish />
    <p class="mb-12 text-base text-muted">recados de quem ama a {eventConfig.person.name}</p>

    <MessagesGrid client:visible />
  </div>
</section>