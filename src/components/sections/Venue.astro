---
import { IconMapPinFilled } from '@tabler/icons-react';
import { eventConfig } from '@/data/event';

const { venue } = eventConfig;
---

<section id="venue" class="relative bg-bg pb-16">
  <div
    class="relative flex h-[55svh] items-center justify-center overflow-hidden bg-linear-to-br from-band to-line/30 sm:h-[70svh]"
  >
    {
      venue.mapsEmbedUrl ? (
        <iframe
          src={venue.mapsEmbedUrl}
          class="absolute inset-0 size-full border-0"
          loading="lazy"
          title={`Mapa: ${venue.name}`}
        />
      ) : (
        <IconMapPinFilled size={36} className="text-brand" />
      )
    }
  </div>

  <div
    data-reveal
    data-from="bottom"
    class="reveal relative z-10 mx-4 -mt-11 max-w-xs rounded-card border border-border bg-surface p-6 sm:mx-12"
  >
    <h2 class="font-display text-2xl italic text-ink">Como chegar</h2>
    <p class="mb-4 mt-2 text-sm text-muted">{venue.address}</p>
    <a
      href={venue.mapsLinkUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block rounded-full border border-action px-5 py-2.5 text-xs uppercase tracking-wide text-action transition-colors hover:bg-action hover:text-on-action"
    >
      Ver rotas no Maps
    </a>
  </div>
</section>