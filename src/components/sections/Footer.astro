---
import { IconBrandInstagram } from '@tabler/icons-react';
import Seal from '@/components/ui/Seal';
import { eventConfig } from '@/data/event';
import { instagramLinks } from '@/lib/instagram'
const { person, date, credit, studio, hashtag } = eventConfig;
---

<footer
  class="relative z-20 flex min-h-[80svh] items-center justify-center rounded-t-card bg-action px-6 py-20 text-center text-on-action"
>
  <div class="mx-auto flex max-w-2xl flex-col items-center">
    <Seal tone="inverse" label={`Selo de ${person.name}, ${person.age} anos`} className="size-20 sm:size-24" />

    <p class="mt-6 font-display text-5xl italic sm:text-6xl">{person.name}</p>
    <p class="mb-10 mt-3 text-base">{person.age} anos · {date.displayDate}</p>

    <a
      href="#rsvp"
      class="relative rounded-full bg-on-action px-9 py-4 text-sm uppercase tracking-wide text-action after:absolute after:inset-0 after:animate-pulse-ring after:rounded-full after:border after:border-on-action"
    >
      Confirmar presença
    </a>

    <div class="mt-12 flex flex-col items-center gap-3">
      <a
        href={instagramLinks.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram ${instagramLinks.handle}`}
        class="flex size-12 items-center justify-center rounded-full border border-on-action/40 transition-colors hover:bg-on-action/15"
      >
        <IconBrandInstagram size={22} />
      </a>
      <a href={instagramLinks.hashtagUrl} target="_blank" rel="noopener noreferrer" class="text-sm underline-offset-4 hover:underline">
        {hashtag}
      </a>
    </div>

    <p class="mt-12 text-xs">
      {credit}
      {' · '}
      <a href={studio.url} class="underline underline-offset-2">{studio.name}</a>
    </p>
  </div>
</footer>