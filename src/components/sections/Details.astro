---
// src/components/sections/Details.astro
import { IconCalendar, IconClock, IconMapPin, IconShirt } from '@tabler/icons-react';
import Flourish from '@/components/ui/Flourish.astro';
import GhostNumeral from '@/components/ui/GhostNumeral.astro';
import { eventConfig } from '@/data/event';

const rows = [
  { icon: IconCalendar, label: 'Data', value: eventConfig.date.displayDate, color: '#9C4F68' },
  { icon: IconClock, label: 'Horário', value: eventConfig.date.displayTime, color: '#B08A4A' },
  { icon: IconMapPin, label: 'Local', value: eventConfig.venue.name, color: '#7C8768' },
  { icon: IconShirt, label: eventConfig.dressCode.title, value: eventConfig.dressCode.description, color: '#9C4F68' },
];
---

<section id="details" class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-bg">
  <div id="details-card" class="relative mx-auto w-[80%] min-h-screen overflow-hidden px-6 py-20 sm:px-16">
    <GhostNumeral number="01" size="260px" left="20px" />

    <div class="relative z-10 mx-auto w-[92%] max-w-6xl rounded-2xl bg-surface p-8 sm:p-12">
      <div class="mb-10">
        <p class="font-display text-5xl italic text-ink sm:text-6xl">Detalhes</p>
        <Flourish align="left" />
        <p class="text-base text-muted">tudo que você precisa saber pra não perder nada desse dia</p>
      </div>

      <div>
        {rows.map((row) => (
          <div class="flex items-center justify-between border-b border-black/8 py-5 last:border-none">
            <span class="flex items-center gap-3">
              <row.icon size={20} style={{ color: row.color }} />
              <span class="text-xs uppercase tracking-wide text-muted">{row.label}</span>
            </span>
            <span class="text-lg font-medium text-ink">{row.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #details-card {
    background: linear-gradient(135deg, #e3b9c8 0%, #d8c08a 50%, #a3ae8c 100%);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    animation: details-wave 4s ease-in-out infinite;
    transition:
      width 900ms cubic-bezier(0.4, 0, 0.2, 1) 1000ms,
      border-radius 900ms cubic-bezier(0.4, 0, 0.2, 1) 1000ms;
  }

  @keyframes details-wave {
    0%, 100% { border-top-left-radius: 24px; border-top-right-radius: 24px; }
    33% { border-top-left-radius: 56px; border-top-right-radius: 16px; }
    66% { border-top-left-radius: 16px; border-top-right-radius: 56px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #details-card { animation: none; }
  }
</style>

<script>
  function initDetailsReveal() {
    const section = document.getElementById('details');
    const card = document.getElementById('details-card');
    if (!section || !card) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function expand() {
      if (!card) return;
      card.style.animation = 'none';
      card.style.width = '100%';
      card.style.borderTopLeftRadius = '0px';
      card.style.borderTopRightRadius = '0px';
    }

    if (reduceMotion) {
      expand();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          expand();
          observer.disconnect();
        });
      },
      { threshold: 0.2 },
    );

    observer.observe(section);
  }

  initDetailsReveal();
</script>