---
import GhostNumeral from '@/components/ui/GhostNumeral.astro';
import { eventConfig } from '@/data/event';

const eventDate = new Date(eventConfig.date.iso);

function formatDate(options: Intl.DateTimeFormatOptions): string {
  return new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', ...options }).format(eventDate);
}

const day = formatDate({ day: '2-digit' });
const month = formatDate({ month: 'short' }).replace('.', '');
const year = formatDate({ year: 'numeric' });

const rows = [
  { label: 'Horário', value: eventConfig.date.displayTime },
  { label: 'Local', value: eventConfig.venue.name },
  { label: eventConfig.dressCode.title, value: eventConfig.dressCode.description },
];
---

<section id="details" class="relative flex min-h-svh w-full items-center justify-center overflow-hidden bg-bg">
  <div
    id="details-card"
    class="relative mx-auto flex min-h-svh w-[90%] items-center justify-center overflow-hidden px-4 py-16 sm:w-[80%] sm:px-16 sm:py-20"
  >
    <GhostNumeral number="01" size="260px" left="20px" />

    <div class="ticket relative z-10 flex w-full max-w-3xl flex-col rounded-2xl bg-surface sm:flex-row">
      <div
        class="ticket-stub flex flex-none flex-col items-center justify-center border-b-2 border-dashed border-accent/30 px-2 sm:border-b-0 sm:border-r-2"
      >
        <p class="text-[11px] uppercase tracking-[0.15em] text-muted sm:text-xs">{month}</p>
        <p class="font-display text-7xl italic leading-none text-accent sm:text-8xl">{day}</p>
        <p class="text-[11px] uppercase tracking-[0.15em] text-muted sm:text-xs">{year}</p>
      </div>

      <div class="flex-1 px-6 py-6 sm:px-10 sm:py-9">
        <p class="text-[11px] uppercase tracking-[0.15em] text-gold sm:text-xs">Detalhes</p>
        <p class="mb-3 mt-1 font-display text-3xl italic text-ink sm:text-4xl">Seu lugar na festa</p>

        {rows.map((row) => (
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-border py-4 last:border-none">
            <span class="text-xs uppercase tracking-wide text-muted">{row.label}</span>
            <span class="text-right text-lg font-medium text-ink">{row.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #details-card {
    background: linear-gradient(135deg, #e3b9c8 0%, #d8c08a 50%, #a3ae8c 100%);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    animation: details-wave 4s ease-in-out infinite;
    transition:
      width 900ms cubic-bezier(0.4, 0, 0.2, 1) 1000ms,
      border-radius 900ms cubic-bezier(0.4, 0, 0.2, 1) 1000ms;
  }

  @keyframes details-wave {
    0%, 100% { border-top-left-radius: 24px; border-top-right-radius: 24px; }
    33% { border-top-left-radius: 56px; border-top-right-radius: 16px; }
    66% { border-top-left-radius: 16px; border-top-right-radius: 56px; }
  }

  /* Ticket notches: two half-height masks punch a circle out of the
     tear line. Vertical layout on mobile, horizontal from 640px up. */
  .ticket {
    --notch: 12px;
    --notch-edge: calc(var(--notch) + 1px);
    --stub-size: 150px;
    -webkit-mask:
      radial-gradient(circle at 0 var(--stub-size), #0000 var(--notch), #000 var(--notch-edge)) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% var(--stub-size), #0000 var(--notch), #000 var(--notch-edge)) right / 51% 100% no-repeat;
    mask:
      radial-gradient(circle at 0 var(--stub-size), #0000 var(--notch), #000 var(--notch-edge)) left / 51% 100% no-repeat,
      radial-gradient(circle at 100% var(--stub-size), #0000 var(--notch), #000 var(--notch-edge)) right / 51% 100% no-repeat;
  }

  .ticket-stub {
    height: var(--stub-size);
  }

  @media (min-width: 640px) {
    .ticket {
      --stub-size: 190px;
      -webkit-mask:
        radial-gradient(circle at var(--stub-size) 0, #0000 var(--notch), #000 var(--notch-edge)) top / 100% 51% no-repeat,
        radial-gradient(circle at var(--stub-size) 100%, #0000 var(--notch), #000 var(--notch-edge)) bottom / 100% 51% no-repeat;
      mask:
        radial-gradient(circle at var(--stub-size) 0, #0000 var(--notch), #000 var(--notch-edge)) top / 100% 51% no-repeat,
        radial-gradient(circle at var(--stub-size) 100%, #0000 var(--notch), #000 var(--notch-edge)) bottom / 100% 51% no-repeat;
    }

    .ticket-stub {
      width: var(--stub-size);
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #details-card { animation: none; }
  }
</style>

<script>
  function initDetailsReveal() {
    const section = document.getElementById('details');
    const card = document.getElementById('details-card');
    if (!section || !card) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function expand() {
      if (!card) return;
      card.style.animation = 'none';
      card.style.width = '100%';
      card.style.borderTopLeftRadius = '0px';
      card.style.borderTopRightRadius = '0px';
    }

    if (reduceMotion) {
      expand();
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          expand();
          observer.disconnect();
        });
      },
      { threshold: 0.2 },
    );

    observer.observe(section);
  }

  initDetailsReveal();
</script>