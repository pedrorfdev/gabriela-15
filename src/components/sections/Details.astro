---
import { IconClock, IconShirt } from '@tabler/icons-react';
import Flourish from '@/components/ui/Flourish.astro';
import GhostNumeral from '@/components/ui/GhostNumeral.astro';
import { eventConfig } from '@/data/event';
import '@/styles/details-tear.css';

const eventDate = new Date(eventConfig.date.iso);

function formatDate(options: Intl.DateTimeFormatOptions): string {
  return new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', ...options }).format(eventDate);
}

const day = formatDate({ day: '2-digit' });
const month = formatDate({ month: 'short' }).replace('.', '');
const year = formatDate({ year: 'numeric' });

const labelClass = 'text-[11px] uppercase tracking-[0.12em] text-muted';
---

<section
  id="details"
  class="details-section relative flex min-h-svh w-full items-center justify-center overflow-hidden px-4 py-16 sm:px-12 sm:py-20"
>
  <GhostNumeral number="01" size="260px" left="20px" />

  <div class="relative z-10 w-full max-w-4xl">
    <div class="mb-2 sm:mb-4">
      <!-- Fixed dark color on purpose: this text sits on the gradient,
           which stays light in both themes. -->
      <p class="text-[11px] uppercase tracking-[0.15em] text-[#3A322E]/70">Detalhes</p>
      <h2 class="mt-1 font-display text-4xl italic text-[#3A322E] sm:text-5xl">Seu lugar na festa</h2>
      <Flourish align="left" />
    </div>

    <div id="details-stage" class="details-stage" data-state="whole">
      <div class="details-half details-half--start">
        <div class="details-tile details-tile--date">
          <p class="text-[11px] uppercase tracking-[0.15em] text-muted sm:text-xs">{month}</p>
          <p class="font-display text-7xl italic leading-none text-accent sm:text-8xl">{day}</p>
          <p class="text-[11px] uppercase tracking-[0.15em] text-muted sm:text-xs">{year}</p>
        </div>
      </div>

      <div class="details-half details-half--end">
        <div class="details-tile details-tile--time">
          <p class={labelClass}>Horário</p>
          <div class="flex items-center gap-2">
            <IconClock size={22} className="text-gold" />
            <p class="text-2xl font-medium text-ink sm:text-3xl">{eventConfig.date.displayTime}</p>
          </div>
        </div>

        <div class="details-tile details-tile--place">
          <p class={labelClass}>Local</p>
          <div>
            <svg viewBox="0 0 120 34" class="mb-1 h-8 w-full" fill="none" aria-hidden="true">
              <path d="M10 28 Q 40 4 62 18 T 110 8" stroke="var(--color-gold)" stroke-width="1.5" stroke-dasharray="5 5" />
              <circle cx="10" cy="28" r="4" fill="var(--color-accent)" />
              <circle cx="110" cy="8" r="4" fill="var(--color-accent)" />
            </svg>
            <p class="text-base font-medium text-ink sm:text-lg">{eventConfig.venue.name}</p>
          </div>
        </div>

        <div class="details-tile details-tile--dress">
          <p class={labelClass}>{eventConfig.dressCode.title}</p>
          <div class="flex items-center justify-between gap-3">
            <p class="text-base font-medium text-ink sm:text-lg">{eventConfig.dressCode.description}</p>
            <IconShirt size={24} className="flex-none text-accent" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initDetailsTear } from '@/scripts/details-tear';

  initDetailsTear();
</script>