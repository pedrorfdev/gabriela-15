---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PasswordGate from '@/components/islands/PasswordGate';
import NavDrawer from '@/components/islands/NavDrawer';
import Hero from '@/components/sections/Hero.astro';
import Details from '@/components/sections/Details.astro';
import Venue from '@/components/sections/Venue.astro';
import Recommendations from '@/components/sections/Recommendations.astro';
import Gifts from '@/components/sections/Gifts.astro';
import GallerySection from '@/components/sections/GallerySection.astro';
import MessagesSection from '@/components/sections/MessagesSection.astro';
import RsvpSection from '@/components/sections/RsvpSection.astro';
import Footer from '@/components/sections/Footer.astro';
import { eventConfig } from '@/data/event';
import BackToTop from '@/components/ui/BackToTop.astro';
---

<BaseLayout title={`${eventConfig.person.name} · ${eventConfig.person.age} anos`}>
  <PasswordGate client:load />
  <NavDrawer client:idle />
  <BackToTop />

  <main>
    <Hero />
    <Details />
    <Venue />
    <Recommendations />
    <Gifts />
    <GallerySection />
    <MessagesSection />
    <RsvpSection />
    <Footer />
  </main>
</BaseLayout>
